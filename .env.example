# Resend — used by /api/email-download to mail documents as attachments.
# Domain (deaisummit.org) must be verified in the Resend dashboard.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_NAME=DeAI Summit
RESEND_FROM_EMAIL=contact@deaisummit.org

# Backend API (SSR prefetch + /api proxies).
# Local: point at your running ep-api (usually :3000).
# Or use production: https://api.gconf.ai/api
NEXT_PUBLIC_GCONF_API_URL=http://localhost:3000/api

# Prefer the per-site key from Dashboard → Sites → DeAISumit → Site API key (sk_site_…).
# Falls back to the tenant Website API key if no site key is set.
# Ticket sales need the SITE key (sk_site_…): a tenant key gets 403 SITE_REQUIRED on /site/tickets/*.
GCONF_SITE_KEY=
GCONF_API_KEY=

# Optional legacy client-visible fallbacks (prefer server-only keys above).
# NEXT_PUBLIC_GCONF_API_KEY=

TENANT_SLUG=deaisummit
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Analytics (GTM, GA4, LinkedIn, Reddit, GSC): Dashboard → Settings → Analytics tags only
# — loaded at build/request time via the API URL + site/tenant key above.

# Tickets: `true` switches /tickets from the CMS page with Luma links to the live GConf.ai checkout
# (live list, Stripe checkout, buyer/holder pages under /tickets/*, the CMS Tickets section).
# Server-only. Leave false in production until the go-live checklist is done.
# No Stripe variable is needed: the publishable key comes from ep-api with each order.
TICKETS_CHECKOUT_ENABLED=false
