# Resend Configuration
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# The display name for outgoing emails
RESEND_FROM_NAME=DeAI Summit

# The sender email address (Must be verified in Resend)
RESEND_FROM_EMAIL=contact@deaisummit.org

# The inbox where you want to receive form submissions
RESEND_TO_EMAIL=contact@deaisummit.org

# Backend API (SSR prefetch + /api proxies).
# Local: point at your running ep-api (usually :3000).
# Or use production: https://api.gconf.ai/api
NEXT_PUBLIC_GCONF_API_URL=http://localhost:3000/api

# Prefer the per-site key from Dashboard → Sites → DeAISumit → Site API key (sk_site_…).
# Falls back to the tenant Website API key if no site key is set.
GCONF_SITE_KEY=
GCONF_API_KEY=

# Optional legacy client-visible fallbacks (prefer server-only keys above).
# NEXT_PUBLIC_GCONF_API_KEY=

TENANT_SLUG=deaisummit
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Analytics (GTM, GA4, LinkedIn, Reddit, GSC): Dashboard → Settings → Analytics tags only
# — loaded at build/request time via the API URL + site/tenant key above.
